{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-local-model-discovery",
  "version": "1.0.0",
  "description": "OpenCode plugin for auto-discovery of models from any local OpenAI-compatible API",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "opencode.json.example"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "build": "bun run typecheck && bun run test:run",
    "pack": "bun scripts/pack.ts",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "plugin",
    "litellm",
    "vllm",
    "ollama",
    "lmstudio",
    "local-llm",
    "openai-compatible",
    "model-discovery"
  ],
  "license": "MIT",
  "engines": {
    "opencode": ">=1.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grilled-pork-chop/opencode-local-model-discovery-plugin.git"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.4.8"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}
